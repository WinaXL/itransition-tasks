<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cv_position_import_form" model="ir.ui.view">
        <field name="name">cv.position.import.form</field>
        <field name="model">cv.position.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="base_url"/>
                    <field name="api_token"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cv_position_import" model="ir.actions.act_window">
        <field name="name">Import from CVForge</field>
        <field name="res_model">cv.position.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
