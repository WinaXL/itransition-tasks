# PostgreSQL connection string (Render / Neon / local)
# For Render, append ?sslmode=require to the External Database URL
DATABASE_URL=postgresql://user:password@host:5432/cvdb?sslmode=require

# Secret for signing session JWTs
JWT_SECRET=change-me

# Where the SPA lives (used for OAuth redirects back to the app)
APP_URL=http://localhost:5173
# Where this API is reachable (used for OAuth callback URLs)
API_URL=http://localhost:3000

# Google OAuth — authorized redirect URI must be exactly:
#   {API_URL}/api/auth/google/callback
# e.g. https://cv-management-tdgj.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — Authorization callback URL must be exactly:
#   {API_URL}/api/auth/github/callback
# e.g. https://cv-management-tdgj.onrender.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Salesforce CRM integration ----------
# Connected App (Setup → App Manager → New Connected App):
#   - Enable OAuth Settings, add scope "Manage user data via APIs (api)"
#   - Enable "Client Credentials Flow" and set a run-as user on the app policies
# Consumer Key / Consumer Secret of the Connected App:
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Your org login URL, e.g. https://yourdomain-dev-ed.develop.my.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# ---------- Dropbox (support tickets for the Power Automate flow) ----------
# Create an app at https://www.dropbox.com/developers/apps with the
# files.content.write scope. Either paste a generated access token:
DROPBOX_ACCESS_TOKEN=
# ...or (recommended, tokens don't expire) use the refresh-token flow:
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
